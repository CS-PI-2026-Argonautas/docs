@startuml class

abstract class Pessoa{
  String nome;
  Endereco endereco;
  String telefone;
}

class Funcionario{

  String nome;
  String cpf;
  Cargo cargo;
  Turno turno;

}

enum Turno{
  NOTURNO,
  DIURNO,
}

class Cargo{
  String nome;
  double salario;
}

abstract class Cliente{
  int id;
  String email;
  String obs;

}

class PessoaJuridica {
  int id;
  
  String cnpj;
  String setor;
}

class PessoaFisica{
  int id;

  String cpf;
}

class OrdemServicos{
  int id;
  Servico[] servicos;
  Peca[] peca;
  Equipamento equipamento;
  Cliente cliente;
  Funcionario responsavel;
  Date data;
  StatusOrdemServico status;
  String relatorio;
}

class Equipamento {
  int id;
  String marca;
  String modelo;
  String numeroSerie;
  String portaria;
  String numeroInmetro;
  String numeroVerificacao;
  String seloAnterior;
  String seloAtual;
  String lacreAnterior;
  String lacreAtual;
}

class Endereco {
  int id;
  String cep;
  String rua;
  String complemento;
  String cidade;
  String numero;
  String uf;
}

class Servico{
  int id;
  String nome,
  String descricao,
  BigDecimal valor,
}

class Peca{
  int id;
  String nome;
  String descricao;
  TipoItem tipo;
  BigDecimal valor;
}

enum StatusOrdemServico {
  EM_ORCAMENTO, 
  EM_CONSERTO,
  CONCLUIDA,
  ENTREGUE,
  PAGA,
}

Cliente <|-- PessoaFisica
Cliente <|-- PessoaJuridica
Servico --* OrdemServicos
Funcionario --* OrdemServicos

Funcionario <-- Turno
Funcionario <-- Cargo

Equipamento *-- OrdemServicos
StatusOrdemServico *-- OrdemServicos
Endereco *-- Pessoa
Peca o-- OrdemServicos

OrdemServicos *-- Cliente

Pessoa <|-- Funcionario
Cliente --|> Pessoa

@enduml